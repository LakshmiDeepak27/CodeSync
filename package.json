{
  "name": "codesync",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@codesync/shared",
    "dev:server": "npm run dev --workspace=codesync-server",
    "dev:client": "npm run dev --workspace=codesync-client",
    "dev": "concurrently -n \"server,client\" -c \"blue,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "lint:client": "npm run lint --workspace=codesync-client",
    "lint": "npm run lint --workspace=codesync-client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.19.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^5.22.0",
    "braces": "^3.0.3",
    "ecdsa-sig-formatter": "^1.0.11",
    "fast-glob": "^3.3.3",
    "jsonwebtoken": "^9.0.3",
    "jwa": "^2.0.1",
    "jws": "^4.0.1",
    "micromatch": "^4.0.8",
    "postcss-selector-parser": "^7.1.6"
  }
}
